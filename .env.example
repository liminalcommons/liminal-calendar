# Liminal Calendar Configuration
NODE_ENV=development
PORT=3004

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/liminal_calendar

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (NextAuth shared secret)
# AUTH_SECRET must match auth.castalia.one (castalia-one Vercel project)
# so a session set during a Castalia/Logto OAuth callback is verifiable
# across `.liminalcalendar.com` hosts.
AUTH_SECRET=your-auth-secret

# Auth: Sign in with Castalia (Logto OIDC at id.castalia.one)
# - Issuer is the Logto OIDC discovery base; default is fine
# - LOGTO_CLIENT_ID / LOGTO_CLIENT_SECRET come from a "Liminal Calendar" OIDC
#   app registered in Logto admin (or the shared Castalia OIDC app — both work
#   for v1; recommended: register a dedicated app for calendar)
# - The app's redirect URIs in Logto MUST include
#     https://liminalcalendar.com/api/auth/callback/logto
#     https://<preview>.vercel.app/api/auth/callback/logto  (per preview deploy)
#     http://localhost:3004/api/auth/callback/logto
LOGTO_ISSUER=https://id.castalia.one/oidc
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=

# Auth (Clerk — primary login. Castalia/Logto is the alternative path.)
# Dev keys: dashboard.clerk.com → API keys
# Production: separate Clerk production instance required.
# See docs/clerk-integration-handoff.md for owner activation checklist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhook signing secret — copied from Clerk dashboard → Configure → Webhooks
# (per-endpoint). Required for /api/webhooks/clerk signature verification.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Google Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3004/auth/google/callback

# Authentication
JWT_SECRET=your-jwt-secret-min-32-chars
SESSION_SECRET=your-session-secret-min-32-chars

# Redis (for session storage)
REDIS_URL=redis://localhost:6379

# Email Reminders (choose one provider)
# Option 1: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option 2: Resend (recommended)
RESEND_API_KEY=re_...
EMAIL_FROM=calendar@liminalcommons.com

# Cron Job Security
CRON_SECRET=your-random-secret-for-cron-auth

# Signing key for tokenized email links (reminder stop-tokens + newsletter
# unsubscribe links). Optional — falls back to CRON_SECRET when unset. Set a
# dedicated value to keep the email-link signing key separate from cron auth.
STOP_TOKEN_SECRET=your-random-secret-for-email-link-tokens
